# Environment and secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
vendor/

# Laravel runtime
storage/logs/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
bootstrap/cache/*.php
backend/storage/logs/
backend/storage/framework/cache/
backend/storage/framework/sessions/
backend/storage/framework/views/
backend/bootstrap/cache/*.php

# Frontend build output
frontend/dist/
dist/

# Temporary files and logs
tmp/
*.log
*.tgz
*.tar
*.tar.gz
*.zip

# OS and IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local Codex/VM/private helper files
.codex/ssh/

# Scaffold/runtime scratch area
.scaffold/

# Docker local data if bind-mounted in the future
postgres_data/
docker-data/
volumes/
# Local DEV HTTPS certificates and private keys
infra/dev-https/certs/
*.key
*.csr
*.srl

# Private import files with real personal data
storage/app/private/imports/
backend/storage/app/private/imports/
*.xls

# Release artifacts and installer runtime output
releases/
installer/*.tar.gz
installer/*.sha256
installer/.env
installer/certs/
installer/backups/

# GITHUB-001 repository safety
backend/.env
frontend/.env
.env.local
.env.production
.env.development
!backend/storage/app/private/.gitignore
backend/storage/app/private/applicant-documents/
backend/storage/framework/testing/
backend/database/database.sqlite
uploads/
dumps/
temp/
*.sql
*.dump
*.backup
*.bak
*.pem
*.p12
*.pfx
*.crt
*.cer
# Real import/export files must stay outside Git. Official reference templates
# under docs/external-services are intentionally allowed.
*.xlsx
*.csv
!docs/external-services/**/*.xlsx
!docs/import-templates/**/*.csv
admin_credentials.txt
**/admin_credentials.txt
installer/runtime/
playwright-report/
test-results/
screenshots/
coverage/

# Official FIS reference materials are downloaded locally and may be license-restricted
backend/storage/app/private/reference/fis/

# Runtime secrets
.secrets/
backend/.secrets/
backend/storage/app/private/fis-specs/
