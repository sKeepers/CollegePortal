APP_NAME=CollegePortal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
APP_VERSION=0.8.0-rc2
APP_RELEASE=v0.8.0-rc2

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=college_portal
DB_USERNAME=college_user
DB_PASSWORD=college_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
API_TOKEN_TTL_MINUTES=720

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@college-portal.local
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Official FIS GIA and Admissions outbound connector
FIS_API_ENABLED=false
FIS_API_MODE=test
FIS_API_ALLOW_PRODUCTION_SEND=false
FIS_API_TEST_ENDPOINT=http://10.0.3.1:8383/api/import/importservice.svc
FIS_API_PRODUCTION_ENDPOINT=http://10.0.3.1:8080/api/import/importservice.svc
FIS_API_CONNECT_TIMEOUT=5
FIS_API_REQUEST_TIMEOUT=30
# Версия официальной спецификации. Пусто — берётся 4.9 из resources/fis/gia-priem.
FIS_API_SCHEMA_VERSION=
FIS_API_SPEC_MANIFEST_PATH=
FIS_API_XSD_PATH=
# Справочник ФИС №5 «Пол». Значения берутся методом получения элементов
# справочника через шлюз; пока не заданы, сборка заявлений отказывает.
FIS_DICT_GENDER_MALE=
FIS_DICT_GENDER_FEMALE=
FIS_API_WSDL_PATH=

FIS_API_TRANSPORT=soap
FIS_GATEWAY_URL=
FIS_GATEWAY_ENABLED=false
FIS_GATEWAY_SHARED_SECRET=
FIS_GATEWAY_ALLOWED_ENVIRONMENT=test
FIS_GATEWAY_CONNECT_TIMEOUT=5
FIS_GATEWAY_REQUEST_TIMEOUT=30
COLLEGEPORTAL_GATEWAY_SECRET_FILE=/srv/college-dev/.secrets/collegeportal-gateway.env
