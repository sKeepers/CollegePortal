<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Набор давно шёл впритык: пик около 120 МБ при стандартном лимите 128 МБ,
            и очередной добавленный тест ронял прогон целиком с «Allowed memory size
            exhausted» — сообщением, по которому не видно, что дело не в правке.
            Лимит задан здесь, а не флагом: `artisan test` запускает phpunit отдельным
            процессом и `php -d memory_limit=...` до него не доходит.
        -->
        <!--
            Поднято до гигабайта 11.08.2026. Набор демонстрационных данных дорос
            до журнала, нагрузки, движка расписания и выпускников, и тесты, что
            наполняют и очищают стенд целиком, стали упираться в прежние 512 МБ
            ближе к концу прогона: тест отвечал пятисотой в полном прогоне и
            проходил в изоляции. Это тот же потолок, а не дефект правки.
        -->
        <ini name="memory_limit" value="1024M"/>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Пароль служебных учетных записей закреплен здесь, потому что тесты
            сверяют его значением. Без этого прогон зависел от `.env` стенда:
            стоило задать на DEV собственный пароль, и три теста падали
            «Failed asserting that false is true» без связи с правкой.
        -->
        <server name="DEMO_USER_PASSWORD" value="test1234"/>
        <!--
            То же самое и по той же причине: на стенде Telegram-вход настроен, и набор,
            читающий ключи из `.env`, начинал видеть подключённый способ входа там, где
            проверяется поведение без него. Тест, которому Telegram нужен, ставит эти
            значения сам.
        -->
        <server name="TELEGRAM_LOGIN_BOT_USERNAME" value=""/>
        <server name="TELEGRAM_LOGIN_BOT_TOKEN" value=""/>
        <server name="MAX_BOT_USERNAME" value=""/>
        <server name="MAX_BOT_TOKEN" value=""/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="DB_URL" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
