# Leave empty in VM/dev browser usage to derive API host from the current page.
# Example override: VITE_API_BASE_URL=http://192.168.34.104:8080/api
VITE_API_BASE_URL=

# development | test | production
VITE_APP_ENV=development

# Leave disabled by default. DEV helper is compiled only in Vite dev mode.
VITE_DEV_LOGIN_HELPER=false
VITE_DEV_LOGIN_HELPER_HOSTS=localhost,127.0.0.1,192.168.34.104,college-dev.local
